# Copy this file to .env (ignored by git) and fill in values locally.
# Never commit real credentials.

# Hy3 API — OpenAI-compatible chat-completions endpoint.
# Find your endpoint, model name, and key via the Hy3 repo / Tencent Cloud console:
# https://github.com/Tencent-Hunyuan/Hy3
HY3_API_BASE=
HY3_API_KEY=

# Model names (agent and judge are configured separately; they may be the same model)
HY3_AGENT_MODEL=
HY3_JUDGE_MODEL=

# Budget guards (see docs/ROADMAP.md decision 12 — single-attempt campaign)
HY3_MAX_TURNS=25
HY3_REQUEST_TIMEOUT_S=120
